{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockhub.local/schemas/dashboard-import.schema.json",
  "title": "StockHub Dashboard Import",
  "type": "object",
  "additionalProperties": false,
  "required": ["products", "orders"],
  "properties": {
    "products": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sku", "name", "onHand", "basePrice"],
        "properties": {
          "sku": { "type": "string", "minLength": 1, "maxLength": 64 },
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "onHand": { "type": "integer", "minimum": 0 },
          "basePrice": { "type": "number", "minimum": 0 },
          "category": { "type": ["string", "null"], "maxLength": 80 }
        }
      }
    },
    "orders": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["orderNumber", "platform", "customerName", "shipTo", "carrier", "placedAt", "status", "items"],
        "properties": {
          "orderNumber": { "type": "string", "minLength": 1, "maxLength": 64 },
          "platform": { "type": "string", "enum": ["Amazon", "Unieuro", "Euronics", "eBay"] },
          "customerName": { "type": "string", "minLength": 1, "maxLength": 160 },
          "shipTo": { "type": "string", "minLength": 1, "maxLength": 240 },
          "carrier": { "type": "string", "minLength": 1, "maxLength": 160 },
          "placedAt": { "type": "string", "format": "date-time" },
          "status": {
            "type": "string",
            "enum": ["AwaitingPayment", "PaidToPick", "PickedToShip", "Shipped", "Delivered", "ReturnRequested", "Cancelled"]
          },
          "fee": { "type": ["number", "null"], "minimum": 0 },
          "returnReason": { "type": ["string", "null"], "maxLength": 240 },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sku", "productName", "quantity", "unitPrice"],
              "properties": {
                "sku": { "type": "string", "minLength": 1, "maxLength": 64 },
                "productName": { "type": "string", "minLength": 1, "maxLength": 160 },
                "quantity": { "type": "integer", "minimum": 1 },
                "unitPrice": { "type": "number", "minimum": 0 },
                "costOfGoods": { "type": ["number", "null"], "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
