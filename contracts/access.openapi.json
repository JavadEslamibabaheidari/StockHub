{
  "openapi": "3.0.3",
  "info": { "title": "StockHub Access API", "version": "1.0.0" },
  "paths": {
    "/api/auth/sign-up": { "post": { "operationId": "signUp", "responses": { "201": { "description": "Authenticated" }, "409": { "$ref": "#/components/responses/Problem" }, "422": { "$ref": "#/components/responses/Problem" } } } },
    "/api/auth/sign-in": { "post": { "operationId": "signIn", "responses": { "200": { "description": "Authenticated" }, "401": { "$ref": "#/components/responses/Problem" }, "422": { "$ref": "#/components/responses/Problem" } } } },
    "/api/auth/sign-out": { "post": { "operationId": "signOut", "responses": { "204": { "description": "Signed out" } } } },
    "/api/auth/password-reset/request": { "post": { "operationId": "requestPasswordReset", "responses": { "202": { "description": "A reset email is sent when an account exists" }, "422": { "$ref": "#/components/responses/Problem" }, "503": { "$ref": "#/components/responses/Problem" } } } },
    "/api/auth/password-reset/confirm": { "post": { "operationId": "confirmPasswordReset", "responses": { "204": { "description": "Password changed and sessions revoked" }, "422": { "$ref": "#/components/responses/Problem" } } } },
    "/api/auth/session": { "get": { "operationId": "getSession", "responses": { "200": { "$ref": "#/components/responses/Session" }, "401": { "$ref": "#/components/responses/Problem" } } } },
    "/api/workspaces": { "get": { "operationId": "listWorkspaces", "responses": { "200": { "$ref": "#/components/responses/WorkspaceList" } } }, "post": { "operationId": "createWorkspace", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "201": { "$ref": "#/components/responses/Workspace" }, "422": { "$ref": "#/components/responses/Problem" } } } },
    "/api/workspaces/{workspaceId}/active": { "put": { "operationId": "setActiveWorkspace", "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }], "responses": { "204": { "description": "Active workspace updated" }, "403": { "$ref": "#/components/responses/Problem" } } } },
    "/api/workspaces/{workspaceId}/onboarding": { "get": { "operationId": "getOnboarding", "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }], "responses": { "200": { "description": "Checklist state" }, "403": { "$ref": "#/components/responses/Problem" } } } },
    "/api/workspaces/{workspaceId}/onboarding/actions": { "post": { "operationId": "selectOnboardingAction", "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }], "responses": { "202": { "description": "Handoff selected" }, "403": { "$ref": "#/components/responses/Problem" } } } },
    "/api/workspaces/{workspaceId}/invitations": { "post": { "operationId": "createInvitation", "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }], "responses": { "202": { "description": "Invitation requested" }, "403": { "$ref": "#/components/responses/Problem" } } } },
    "/api/invitations/{token}": { "get": { "operationId": "getInvitation", "responses": { "200": { "description": "Pending invitation" }, "404": { "$ref": "#/components/responses/Problem" } } } },
    "/api/auth/google/availability": { "get": { "operationId": "getGoogleAvailability", "responses": { "200": { "description": "Whether provider configuration is present" } } } },
    "/api/auth/google/start": { "get": { "operationId": "startGoogleSignIn", "responses": { "302": { "description": "Provider redirect" }, "503": { "$ref": "#/components/responses/Problem" } } } },
    "/api/auth/google/callback": { "get": { "operationId": "googleCallback", "responses": { "302": { "description": "Provider callback handled by OpenID Connect middleware" } } } },
    "/api/auth/google/complete": { "get": { "operationId": "completeGoogleSignIn", "responses": { "302": { "description": "StockHub session established or safe error route" } } } }
  },
  "components": {
    "parameters": {
      "WorkspaceId": { "name": "workspaceId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1 } }
    },
    "responses": {
      "Problem": { "description": "RFC 7807-compatible problem", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Session": { "description": "Current session", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SessionResponse" } } } },
      "Workspace": { "description": "Workspace", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkspaceResponse" } } } },
      "WorkspaceList": { "description": "Workspace list", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/WorkspaceSummary" } } } } }
    },
    "schemas": {
      "Problem": { "type": "object", "required": ["title", "detail"], "properties": { "title": { "type": "string" }, "detail": { "type": "string" }, "code": { "type": "string", "nullable": true } } },
      "WorkspaceSummary": { "type": "object", "required": ["id", "businessName", "country", "currency", "role"], "properties": { "id": { "type": "string", "format": "uuid" }, "businessName": { "type": "string" }, "country": { "type": "string" }, "currency": { "type": "string" }, "role": { "type": "string" } } },
      "WorkspaceResponse": { "allOf": [{ "$ref": "#/components/schemas/WorkspaceSummary" }, { "type": "object", "properties": { "vatNumber": { "type": "string", "nullable": true }, "slug": { "type": "string" } } }] },
      "SessionResponse": { "type": "object", "required": ["userId", "fullName", "email", "workspaces"], "properties": { "userId": { "type": "string", "format": "uuid" }, "fullName": { "type": "string" }, "email": { "type": "string" }, "activeWorkspaceId": { "type": "string", "format": "uuid", "nullable": true }, "workspaces": { "type": "array", "items": { "$ref": "#/components/schemas/WorkspaceSummary" } } } }
    }
  }
}
