# Copy to a private directory as dev.env, staging.env, and prod.env.
# Use a different random password, public URL, and port in each file; chmod 600 each file.
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
STOCKHUB_PORT=8081
PUBLIC_BASE_URL=http://127.0.0.1:8081
ASPNETCORE_ENVIRONMENT=Production
AUTHENTICATION_SECURE_COOKIES=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
